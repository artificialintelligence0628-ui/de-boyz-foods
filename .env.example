# ---- Server ----
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# ---- Database (Neon) ----
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- Seed admin (used by npm run seed) ----
ADMIN_NAME=De-Boyz Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Resend ----
RESEND_API_KEY=
EMAIL_FROM=De-Boyz Foods <onboarding@resend.dev>

# ---- MTN MoMo (direct, Collections API "Request to Pay") ----
# mock       = local dev, no real prompt (auto-approves after 8 seconds)
# sandbox    = MTN's test environment (run: npm run momo:sandbox to get API user + key)
# production = live money, after MTN approves your business
MOMO_ENV=mock
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
# Production only. Must match what's registered in the MTN portal:
MOMO_CALLBACK_URL=
# Production only, if MTN gives you different values:
# MOMO_BASE_URL=https://proxy.momoapi.mtn.com
# MOMO_TARGET_ENV=mtnghana

# ---- Telecel Cash + AirtelTigo Money (via Paystack Charge API) ----
# MTN above is direct. Telecel and AirtelTigo have no open collections API, so they go through Paystack.
# Leave the key empty and those two networks show as "Unavailable" at checkout (MTN is unaffected).
# In MOMO_ENV=mock they work without a key (Telecel asks for any 4-8 digit voucher code).
PAYSTACK_SECRET_KEY=
# Paystack needs an email on every charge. Used when the customer didn't enter one.
# Defaults to payments@<your CLIENT_ORIGIN host>. Set a real inbox you own if you prefer.
# PAYSTACK_FALLBACK_EMAIL=

# ---- Store settings ----
FREE_DELIVERY_THRESHOLD=200
DELIVERY_FEE=15
DEFAULT_DELIVERY_AREA=Koforidua
